{
  "manifest_version": 3,
  "name": "微小读 · 微信读书网页版助手",
  "short_name": "微小读",
  "version": "0.4.0",
  "description": "微信读书网页版的非官方扩展。支持右键搜书、封面简介预览、快捷加入书架、跳章后回到刚才和全书剩余进度。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://weread.qq.com/web/reader/*"],
      "js": ["reader-return.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://weread.qq.com/*"],
      "js": ["content-config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://weread.qq.com/web/reader/*"],
      "js": ["reader-settings.js"],
      "run_at": "document_idle"
    }
  ]
}
